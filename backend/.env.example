# Django Core Settings
SECRET_KEY=django-insecure-cozy-cottagecore-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (leave empty to use local sqlite3 in development)
# For production (Render), set this to the external PostgreSQL URL
DATABASE_URL=

# CORS Settings (comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Config (for user uploaded images, like profile pictures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

